#!/bin/bash

## Copyright (C) 2012 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## helper-scripts is not a dependency of this package; source pre.bsh only if present.
if [ -f /usr/libexec/helper-scripts/pre.bsh ]; then
   source /usr/libexec/helper-scripts/pre.bsh
fi

true "
#####################################################################
## INFO: BEGIN: ${DPKG_MAINTSCRIPT_PACKAGE:-} ${DPKG_MAINTSCRIPT_NAME:-} $*
#####################################################################
"

debian_sources_backup_unowned() {
   ## Overridable path bases: unset -> production paths, so real dpkg (which sets
   ## none of these) is byte-identical. Only paths are injectable, never a
   ## success/failure signal.
   local debian_sources_file="${debian_sources_file:-/etc/apt/sources.list.d/debian.sources}"
   local do_once_dir="${do_once_dir:-/var/lib/anon-apt-sources-list/do_once}"
   local backup_name="${debian_sources_file}.pre-anon-apt-sources-list.bak"
   local marker="${do_once_dir}/${FUNCNAME[0]}_version_1"
   local query_rc=0

   if [ -f "${marker}" ]; then
      return 0
   fi

   ## Debian 13 (trixie) base install ships an unowned deb822
   ## /etc/apt/sources.list.d/debian.sources. This package ships the same path
   ## as a conffile, so a first install would raise a dpkg conffile prompt
   ## ("File on system created by you or by a script."), fatal under
   ## DEBIAN_FRONTEND=noninteractive with no stdin. Move an unowned on-disk copy
   ## aside before unpack so dpkg installs this package's conffile with no
   ## prompt. Skip a dpkg-owned copy: never seize a package-managed conffile.

   ## Create the marker dir before moving anything: if this fails, dpkg aborts
   ## with debian.sources still in place rather than already moved aside.
   mkdir --parents "${do_once_dir}"

   ## dpkg-query -S rc: 1 == path owned by no package (the case to migrate);
   ## 0 == dpkg-owned; >=2 == fatal (corrupt admindir, DB error, dpkg-query
   ## missing). Capture rc explicitly (errexit-safe) and never treat an unknown
   ## ownership state as "unowned".
   dpkg-query -S "${debian_sources_file}" >/dev/null 2>&1 || query_rc="$?"

   ## Move aside ONLY a copy present on disk AND owned by no package (rc 1). Never
   ## seize a dpkg-owned copy (rc 0) or act on an unknown ownership state (rc >=2)
   ## -- either would drop the admin's conffile.
   ## --no-clobber: never overwrite an existing backup (no data loss).
   if [ -e "${debian_sources_file}" ] && [ "${query_rc}" = "1" ]; then
      mv --no-clobber --verbose -- "${debian_sources_file}" "${backup_name}"
   fi

   ## Record the do-once marker ONLY once the intended end-state is reached: no
   ## copy of debian.sources remains where apt would read it. Any path that left
   ## the file in place (owned, unknown ownership, or a --no-clobber no-op) leaves
   ## the marker unset so a later retry can finish the migration.
   if [ ! -e "${debian_sources_file}" ]; then
      touch "${marker}"
   fi
}

debian_sources_backup_unowned

true "INFO: debhelper beginning here."

#DEBHELPER#

true "INFO: Done with debhelper."

true "
#####################################################################
## INFO: END  : ${DPKG_MAINTSCRIPT_PACKAGE:-} ${DPKG_MAINTSCRIPT_NAME:-} $*
#####################################################################
"

## Explicitly "exit 0", so eventually trapped errors can be ignored.
exit 0
